{
  "name": "memedrop",
  "private": true,
  "description": "Application desktop, serveur Discord et site web MemeDrop.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @memedrop/desktop",
    "dev:web": "npm run dev --workspace @memedrop/web",
    "build": "npm run build:installer --workspace @memedrop/desktop",
    "build:app": "npm run build --workspace @memedrop/desktop",
    "build:protocol": "npm run build --workspace @memedrop/protocol",
    "build:server": "npm run build --workspace @memedrop/server",
    "build:web": "npm run build --workspace @memedrop/web",
    "build:update:win": "npm run build:update:win --workspace @memedrop/desktop",
    "build:signed:win": "npm run build:signed:win --workspace @memedrop/desktop",
    "discord:clear-global-commands": "npm run discord:clear-global-commands --workspace @memedrop/server",
    "discord:clear-guild-commands": "npm run discord:clear-guild-commands --workspace @memedrop/server",
    "lint": "eslint . --max-warnings 0",
    "pack:win": "npm run pack:win --workspace @memedrop/desktop",
    "preview": "npm run preview --workspace @memedrop/desktop",
    "preview:web": "npm run preview --workspace @memedrop/web",
    "server:start": "npm run start --workspace @memedrop/server",
    "test": "npm run test:protocol && npm run test:client && npm run test:web && npm run test:server",
    "test:client": "npm run test --workspace @memedrop/desktop",
    "test:protocol": "npm run test --workspace @memedrop/protocol",
    "test:web": "npm run test --workspace @memedrop/web",
    "test:server": "npm run test --workspace @memedrop/server",
    "typecheck": "npm run typecheck:protocol && npm run typecheck:client && npm run typecheck:server && npm run typecheck:web",
    "typecheck:client": "npm run typecheck --workspace @memedrop/desktop",
    "typecheck:protocol": "npm run typecheck --workspace @memedrop/protocol",
    "typecheck:server": "npm run typecheck --workspace @memedrop/server",
    "typecheck:web": "npm run typecheck --workspace @memedrop/web",
    "update:keygen": "npm run update:keygen --workspace @memedrop/desktop"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.4.1"
  }
}
