{
  "name": "memedrop",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && npm run build:server && electron-builder",
    "build:server": "tsc -p tsconfig.server.json",
    "discord:clear-global-commands": "node scripts/clearGlobalCommands.mjs",
    "discord:clear-guild-commands": "node scripts/clearGuildCommands.mjs",
    "pack:win": "vue-tsc && vite build && npm run build:server && electron-builder --win --dir",
    "preview": "vite preview",
    "server:start": "node dist-server/server/index.js"
  },
  "build": {
    "appId": "com.memedrop.app",
    "productName": "MemeDrop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://memedrop.maubry94.ovh/updates/win"
      }
    ]
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "vue": "^3.4.21",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js"
}
