{
  "name": "memedrop",
  "private": true,
  "description": "Overlay desktop MemeDrop relié à Discord pour afficher des images, sons et vidéos.",
  "author": "Maubry94",
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build:app": "vue-tsc && vite build && npm run build:server",
    "build": "node scripts/buildWindowsRelease.mjs local",
    "build:update:win": "node scripts/buildWindowsRelease.mjs update",
    "build:signed:win": "node scripts/buildWindowsRelease.mjs signed",
    "build:server": "tsc -p tsconfig.server.json",
    "discord:clear-global-commands": "node scripts/clearGlobalCommands.mjs",
    "discord:clear-guild-commands": "node scripts/clearGuildCommands.mjs",
    "lint": "eslint . --max-warnings 0",
    "pack:win": "node scripts/buildWindowsRelease.mjs unpacked",
    "preview": "vite preview",
    "server:start": "node dist-server/server/index.js",
    "test": "npm run test:client && npm run test:server",
    "test:client": "node --experimental-strip-types --test electron/client/memedropClient.test.ts electron/client/desktopClient.test.ts electron/core/configStore.test.ts electron/desktop/displays.test.ts src/composables/controlOnboarding.test.ts src/composables/connectionPresentation.test.ts src/composables/dropActionPresentation.test.ts src/composables/updatePresentation.test.ts",
    "test:server": "npm run build:server && node --test \"dist-server/server/**/*.test.js\"",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "update:keygen": "node scripts/generateUpdateSigningKey.mjs"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "electron-updater": "6.8.9",
    "vue": "3.5.41",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vite-plugin-electron": "1.1.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  },
  "main": "dist-electron/main.js"
}
